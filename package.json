{
  "name": "@bobosneefdev/zongodb",
  "version": "5.1.0",
  "author": "bobosneefdev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobosneefdev/ZongoDB.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@standard-community/standard-json": "^0.3.6",
    "@types/bun": "^1.4.2",
    "@types/node": "^25.1.0",
    "@valibot/to-json-schema": "^1.7.1",
    "arktype": "^2.2.3",
    "tsdown": "^0.21.0-beta.2",
    "typescript": "^5.9.3",
    "valibot": "^1.5.0",
    "zod": "^4.6.1"
  },
  "peerDependencies": {
    "mongodb": "^7.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "bugs": {
    "url": "https://github.com/bobosneefdev/ZongoDB/issues"
  },
  "description": "Standard schemas, typed MongoDB collections, and database-enforced validation",
  "directories": {
    "test": "test"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/migration-v5.md"
  ],
  "homepage": "https://github.com/bobosneefdev/ZongoDB#readme",
  "keywords": [
    "mongodb",
    "standard-schema",
    "json-schema",
    "typescript"
  ],
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "tsc --noEmit",
    "build": "tsdown",
    "test": "bun run build && bun test",
    "test:integration": "bun test test/mongo.test.ts",
    "test:package": "bun run build && bun test test/package.test.ts",
    "prepublishOnly": "bun run lint && bun run check && bun run test"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  }
}
