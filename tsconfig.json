{
	"compilerOptions": {
		"strict": true,
		"skipLibCheck": true,
		"noImplicitAny": true,
		"esModuleInterop": true,
		"strictNullChecks": true,
		"target": "ES2022",
		"moduleResolution": "bundler",
		"module": "ESNext",
		"declaration": true,
		"isolatedModules": true,
		"noEmit": true,
		"outDir": "dist"
	},
	"include": ["src", "test", "tsdown.config.ts"],
	"exclude": ["node_modules", "dist"]
}
