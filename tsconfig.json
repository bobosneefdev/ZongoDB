{
	"compilerOptions": {
		"strict": true,
		"noImplicitAny": true,
		"esModuleInterop": true,
		"strictNullChecks": true,
		"target": "ES6",
		"lib": ["ES2022"],
		"moduleResolution": "node",
		"module": "ES6",
		"declaration": true,
		"isolatedModules": true,
		"noEmit": true,
		"outDir": "dist"
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}
